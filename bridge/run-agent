#!/usr/bin/env python3
# run-agent CLI: say "text" | view | status | inbox
import json, os, sys
BASE = os.path.dirname(os.path.abspath(__file__))

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "say":
        text = " ".join(sys.argv[2:]).strip()
        if not text: print("empty"); return
        with open(os.path.join(BASE, "outbox.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps({"text": text}, ensure_ascii=False) + "\n")
        print("queued")
    elif cmd == "view":
        p = os.path.join(BASE, "transcript.txt")
        lines = open(p, encoding="utf-8").read().splitlines() if os.path.exists(p) else []
        print("\n".join(lines[-40:]) if lines else "(no messages yet)")
    elif cmd == "inbox":
        p = os.path.join(BASE, "inbox.jsonl")
        if not os.path.exists(p): print("(empty)"); return
        for line in open(p, encoding="utf-8"):
            r = json.loads(line)
            print(f"◀ {r.get('author','')} [{r.get('createdAt','')}] {r.get('text','')}")
    elif cmd == "status":
        cfg = json.load(open(os.path.join(BASE, "config.json"), encoding="utf-8"))
        st = {}
        sp = os.path.join(BASE, "state.json")
        if os.path.exists(sp): st = json.load(open(sp, encoding="utf-8"))
        room = st.get("room") or {}
        print("room_code:", cfg["room_code"])
        print("messages in room:", len(room.get("messages", [])))
        print("seen:", len(st.get("seen", [])), "delivered:", len(st.get("delivered_acked", [])), "read:", len(st.get("read_acked", [])))
    else:
        print("usage: run-agent say|view|inbox|status")

if __name__ == "__main__":
    main()
